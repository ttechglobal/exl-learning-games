  "snapshot": {
    "cards": [
      {
        "title": "What Is Change of Subject?",
        "body": "Every formula has a 'subject' — the variable on its own. Changing the subject means rearranging so a DIFFERENT variable is isolated."
      },
      {
        "title": "Inverse Operations",
        "body": "To free a variable, reverse what is done to it. Addition → subtract. Multiplication → divide. Square → square root."
      },
      {
        "title": "Work Layer by Layer",
        "body": "Remove one obstacle at a time. Start with whatever is FURTHEST from the variable — the outermost layer first."
      },
      {
        "title": "Nova's Method",
        "body": "1. Identify target variable. 2. Spot the obstacle. 3. Apply the inverse. 4. Repeat until free."
      }
    ]
  },
