  "snapshot": {
    "cards": [
      {
        "title": "What are Simultaneous Equations?",
        "body": "Two equations with two unknowns. We need values that satisfy BOTH at the same time."
      },
      {
        "title": "The Elimination Method",
        "body": "Add or subtract the equations to make one variable disappear. Then solve for the remaining one."
      },
      {
        "title": "When to Multiply First",
        "body": "If the coefficients don't match, multiply one or both equations to make them equal before eliminating."
      },
      {
        "title": "Back-Substitution",
        "body": "Once you know x, substitute into either original equation to find y. Check your answer in both."
      }
    ]
  },
